<?xml version="1.0" encoding="UTF-8"?>
<!--
  GResource-бандл MDWF: иконки маркетплейсов для заголовка окна.

  Храним PNG (не SVG) — растровые иконки грузятся gdk-pixbuf напрямую, без
  SVG-лоадера и без регистрации в IconTheme. Это надёжно на Windows/MinGW,
  где to-pixdata-препроцессинг SVG и theme-рендеринг SVG ненадёжны.

  Грузятся через Image::set_from_resource("resource:///org/mdwf/icons/ozon.png").
  Стилизованы (цвет + буква), НЕ точные копии защищённых логотипов.

  ВНИМАНИЕ: иконка ПРИЛОЖЕНИЯ для ЗАПУЩЕННОГО ОКНА/ТАСКБАРА через
  add_resource_path не работает на Windows (has_icon=false) — она ships как
  файлы в share/icons/hicolor/<size>/apps/mdwf.png бандла (см. scripts/build-release.sh).
  Но для КНОПКИ МЕНЮ в заголовке она же лежит здесь (app.png) и грузится
  напрямую from_resource — не зависит от icon theme и работает и на
  дев-машине, где тема MSYS2 имени «mdwf» не содержит (from_icon_name
  давал белый лист).
-->
<gresources>
  <gresource prefix="/org/mdwf/icons">
    <file alias="app.png" compressed="true">icons/128x128/apps/mdwf.png</file>
    <file alias="ozon.png" compressed="true">icons/ozon.png</file>
    <file alias="wildberries.png" compressed="true">icons/wildberries.png</file>
    <file alias="test.png" compressed="true">icons/test.png</file>
    <file alias="shop-placeholder.png" compressed="true">icons/shop-placeholder.png</file>
    <!-- Иконки типов файлов для списков документов (download/archive).
         Стандартные из темы Adwaita (text-x-generic, x-office-spreadsheet,
         package-x-generic, text-x-script, text-html, application-x-generic);
         PDF нарисован в стиле Adwaita (в теме его нет). -->
    <file alias="file-txt.png" compressed="true">icons/file-txt.png</file>
    <file alias="file-xlsx.png" compressed="true">icons/file-xlsx.png</file>
    <file alias="file-pdf.png" compressed="true">icons/file-pdf.png</file>
    <file alias="file-json.png" compressed="true">icons/file-json.png</file>
    <file alias="file-xml.png" compressed="true">icons/file-xml.png</file>
    <file alias="file-zip.png" compressed="true">icons/file-zip.png</file>
    <file alias="file-generic.png" compressed="true">icons/file-generic.png</file>
  </gresource>
</gresources>
