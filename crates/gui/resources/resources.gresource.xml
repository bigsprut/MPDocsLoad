<?xml version="1.0" encoding="UTF-8"?>
<!--
  GResource-бандл MDWF: иконки маркетплейсов для заголовка окна.

  Регистрируются в теме иконок GTK (IconTheme::add_resource_path), чтобы
  грузиться по имени через Image::set_icon_name("mdwf-ozon") — как обычные
  theme-иконки (open-menu-symbolic и т.п.). preенфикс /org/mdwf/icons.

  SVG компилируются в pixdata на этапе сборки (glib-compile-resources) —
  поэтому SVG-иконки работают в рантайме без SVG-лоадера gdk-pixbuf.

  Имена: mdwf-ozon, mdwf-wildberries, mdwf-test, mdwf-shop-placeholder.
  Стилизованы (цвет + буква), НЕ точные копии защищённых логотипов.
-->
<gresources>
  <gresource prefix="/org/mdwf/icons">
    <!-- Структура theme: <size>/<name>.svg, size=scalable для векторных. -->
    <file alias="scalable/mdwf-ozon.svg" compressed="true" preprocess="to-pixdata">icons/ozon.svg</file>
    <file alias="scalable/mdwf-wildberries.svg" compressed="true" preprocess="to-pixdata">icons/wildberries.svg</file>
    <file alias="scalable/mdwf-test.svg" compressed="true" preprocess="to-pixdata">icons/test.svg</file>
    <file alias="scalable/mdwf-shop-placeholder.svg" compressed="true" preprocess="to-pixdata">icons/shop-placeholder.svg</file>
  </gresource>
</gresources>
