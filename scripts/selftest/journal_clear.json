{
  "name": "journal_clear",
  "isolated": true,
  "ensure_profile": { "provider": "test", "name": "drv" },
  "steps": [
    { "cmd": "load_providers" },
    {
      "cmd": "add_schedule",
      "name": "jc",
      "profile": "drv",
      "report": "test.realization",
      "cron": "0 2 1 * *",
      "wait_event": "SchedulesListed"
    },
    { "cmd": "load_journal", "wait_event": "JournalLoaded" },
    { "cmd": "clear_journal", "wait_event": "JournalCleared" },
    { "cmd": "load_journal", "wait_event": "JournalLoaded" }
  ],
  "expect": [
    { "event": "JournalLoaded", "contains": "1 записей из БД" },
    { "event": "JournalCleared" },
    { "event": "JournalLoaded", "contains": "0 записей из БД" }
  ]
}
